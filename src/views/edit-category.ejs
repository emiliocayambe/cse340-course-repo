<%- include('partials/header') %>
<main class="mx-auto w-full max-w-xl flex-1 px-4 py-10">
  <h1 class="mb-6 text-3xl font-bold text-teal-800"><%= title %></h1>

  <form
    action="/edit-category/<%= categoryDetails.category_id %>"
    method="POST"
    class="space-y-5 rounded-xl border border-slate-200 bg-white p-6 shadow-sm"
  >
    <div class="flex flex-col gap-1">
      <label for="name" class="font-semibold text-slate-800"
        >Category Name</label
      >
      <input
        type="text"
        id="name"
        name="name"
        maxlength="100"
        required
        value="<%= categoryDetails.name %>"
        class="rounded-lg border border-slate-300 px-3 py-2 text-slate-800 focus:border-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-200"
      />
    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      <button
        type="submit"
        class="rounded-lg bg-teal-800 px-4 py-2 font-semibold text-white hover:bg-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-300"
      >
        Update Category
      </button>
      <a
        href="/category/<%= categoryDetails.category_id %>"
        class="rounded-lg border border-slate-300 px-4 py-2 text-center font-semibold text-slate-700 hover:bg-slate-100"
      >
        Cancel
      </a>
    </div>
  </form>
</main>
<%- include('partials/footer') %>
