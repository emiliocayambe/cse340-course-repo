<%- include('partials/header') %>
  <main>
    <h1>
      <%= title %>
    </h1>

    <h2>
      <%= projectDetails.title %>
    </h2>

    <p>Description: <%= projectDetails.description %>
    </p>

    <h3>Service Projects</h3>
    <ul>
      <% organization.forEach(project=> { %>
        <li><a href="/project/<%= organization.project_id %>">
            <%= organization.title %>
          </a></li>
        <% }) %>
    </ul>
  </main>
  <%- include('partials/footer') %>