<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | CSE 340 Service Network</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="flex min-h-screen flex-col bg-slate-50 font-sans text-slate-800 antialiased">
<header class="relative bg-teal-800 text-white shadow-md">
  <nav class="mx-auto flex max-w-5xl flex-wrap items-center justify-between px-4 py-4" aria-label="Main navigation">
    <a href="/" class="text-xl font-bold tracking-tight">CSE 340 Service Network</a>

    <!-- Mobile: burger menu -->
    <details class="group sm:hidden">
      <summary class="cursor-pointer list-none rounded-md p-2 hover:bg-teal-700 [&::-webkit-details-marker]:hidden" aria-label="Toggle menu">
        <svg class="h-6 w-6 group-open:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg class="hidden h-6 w-6 group-open:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </summary>
      <ul class="absolute left-0 right-0 mt-4 flex flex-col bg-teal-800 px-4 pb-4 shadow-md">
        <li><a href="/" class="block rounded-md px-3 py-2 hover:bg-teal-700">Home</a></li>
        <li><a href="/organizations" class="block rounded-md px-3 py-2 hover:bg-teal-700">Organizations</a></li>
        <li><a href="/projects" class="block rounded-md px-3 py-2 hover:bg-teal-700">Projects</a></li>
        <li><a href="/categories" class="block rounded-md px-3 py-2 hover:bg-teal-700">Categories</a></li>
      </ul>
    </details>

    <!-- Desktop: horizontal menu -->
    <ul class="hidden gap-2 sm:flex">
      <li><a href="/" class="rounded-md px-3 py-2 font-medium hover:bg-teal-700">Home</a></li>
      <li><a href="/organizations" class="rounded-md px-3 py-2 font-medium hover:bg-teal-700">Organizations</a></li>
      <li><a href="/projects" class="rounded-md px-3 py-2 font-medium hover:bg-teal-700">Projects</a></li>
      <li><a href="/categories" class="rounded-md px-3 py-2 font-medium hover:bg-teal-700">Categories</a></li>
    </ul>
  </nav>
</header>
