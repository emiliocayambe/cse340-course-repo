<%- include('partials/header') %>
<main class="mx-auto w-full max-w-5xl flex-1 px-4 py-10">
  <h1 class="mb-2 text-3xl font-bold text-teal-900 sm:text-4xl"><%= title %></h1>

  <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-lg text-slate-700">Browse service opportunities by category:</p>
    <a href="/new-category"
       class="inline-flex items-center justify-center rounded-lg bg-teal-800 px-4 py-2 font-semibold text-white shadow-sm hover:bg-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-300">
      + Add a new category
    </a>
  </div>

  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <% categories.forEach(category => { %>
      <li>
        <a href="/category/<%= category.category_id %>"
           class="block rounded-xl bg-white p-6 text-center font-semibold text-slate-900 shadow-sm hover:bg-teal-50 hover:text-teal-800">
          <%= category.name %>
        </a>
      </li>
    <% }); %>
  </ul>
</main>
<%- include('partials/footer') %>