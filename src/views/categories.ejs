<%- include('partials/header') %>
<main class="mx-auto w-full max-w-5xl flex-1 px-4 py-10">
  <h1 class="mb-2 text-3xl font-bold text-teal-900 sm:text-4xl"><%= title %></h1>
  <p class="mb-8 text-lg text-slate-700">Browse service opportunities by category:</p>
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <% categories.forEach(category => { %>
    <li class="rounded-xl bg-white p-6 text-center font-semibold text-slate-900 shadow-sm"><%= category.name %></li>
    <% }); %>
  </ul>
</main>
<%- include('partials/footer') %>
