<%- include('partials/header') %>
<main class="mx-auto w-full max-w-5xl flex-1 px-4 py-10">
  <h1 class="mb-2 text-3xl font-bold text-teal-900 sm:text-4xl"><%= title %></h1>
  <p class="mb-8 text-lg text-slate-700">Here are a few of our partner organizations:</p>
  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
  
    <% organizations.forEach(organization => { %>

    <li class="flex flex-col items-center rounded-xl bg-white p-6 text-center shadow-sm">
      <img class="mb-4 h-24 w-auto object-contain" src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %>">
      <strong class="text-lg text-slate-900"><%= organization.name %></strong>
      <a class="text-teal-700 underline hover:text-teal-900" href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a>
    </li>

    <% }); %>

  </ul>
</main>
<%- include('partials/footer') %>
