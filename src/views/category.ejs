<%- include('partials/header') %>
<main class="mx-auto w-full max-w-5xl flex-1 px-4 py-10">
  <h1 class="mb-6 text-3xl font-bold text-teal-900 sm:text-4xl"><%= title %></h1>

  <section class="mb-10 rounded-xl border-t-4 border-teal-700 bg-white p-6 shadow-sm">
    <h2 class="text-2xl font-semibold text-slate-900"><%= categoryDetails.name %></h2>
  </section>

  <h3 class="mb-4 text-xl font-semibold text-slate-900">Service Projects</h3>
  <% if (projects.length > 0) { %>
    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <% projects.forEach(project => { %>
        <li class="rounded-xl border-t-4 border-teal-700 bg-white p-6 shadow-sm">
          <a class="text-lg font-semibold text-teal-800 hover:underline" href="/project/<%= project.project_id %>"><%= project.title %></a>
          <p class="mt-1 text-sm text-slate-600"><%= project.description %></p>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <p class="text-slate-600">No projects in this category yet.</p>
  <% } %>
  <a href="/categories" class="mt-8 inline-block rounded-lg bg-teal-700 px-5 py-3 font-semibold text-white hover:bg-teal-800">&larr; Back to Categories</a>
</main>
<%- include('partials/footer') %>