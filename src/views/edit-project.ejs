<%- include('partials/header') %>
<main class="mx-auto w-full max-w-xl flex-1 px-4 py-10">
  <h1 class="mb-6 text-3xl font-bold text-teal-800"><%= title %></h1>

  <form action="/edit-project/<%= projectDetails.project_id %>" method="POST"
        class="space-y-5 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex flex-col gap-1">
      <label for="title" class="font-semibold text-slate-800">Project Title</label>
      <input type="text" id="title" name="title" maxlength="150" required
             value="<%= projectDetails.title %>"
             class="rounded-lg border border-slate-300 px-3 py-2 text-slate-800 focus:border-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-200" />
    </div>

    <div class="flex flex-col gap-1">
      <label for="description" class="font-semibold text-slate-800">Description</label>
      <textarea id="description" name="description" maxlength="500" rows="4" required
                class="rounded-lg border border-slate-300 px-3 py-2 text-slate-800 focus:border-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-200"><%= projectDetails.description %></textarea>
    </div>

    <div class="flex flex-col gap-1">
      <label for="location" class="font-semibold text-slate-800">Location</label>
      <input type="text" id="location" name="location" maxlength="255" required
             value="<%= projectDetails.location %>"
             class="rounded-lg border border-slate-300 px-3 py-2 text-slate-800 focus:border-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-200" />
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div class="flex flex-col gap-1">
        <label for="date" class="font-semibold text-slate-800">Date</label>
        <input type="date" id="date" name="date" required
               value="<%= new Date(projectDetails.date).toISOString().split('T')[0] %>"
               class="rounded-lg border border-slate-300 px-3 py-2 text-slate-800 focus:border-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-200" />
      </div>

      <div class="flex flex-col gap-1">
        <label for="organizationId" class="font-semibold text-slate-800">Organization</label>
        <select id="organizationId" name="organizationId" required
                class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-800 focus:border-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-200">
          <option value="">Select an organization</option>
          <% organizations.forEach(org => { %>
            <option value="<%= org.organization_id %>"
              <%= org.organization_id === projectDetails.organization_id ? 'selected' : '' %>>
              <%= org.name %>
            </option>
          <% }); %>
        </select>
      </div>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      <button type="submit"
              class="rounded-lg bg-teal-800 px-4 py-2 font-semibold text-white hover:bg-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-300">
        Update Project
      </button>
      <a href="/project/<%= projectDetails.project_id %>"
         class="rounded-lg border border-slate-300 px-4 py-2 text-center font-semibold text-slate-700 hover:bg-slate-100">
        Cancel
      </a>
    </div>
  </form>
</main>
<%- include('partials/footer') %>